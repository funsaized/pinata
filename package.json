{
  "name": "pi-pinata",
  "version": "2.0.1",
  "description": "Pi stays small. Your subagent system should too. Fast, opinionated subagents with sharp defaults and your wiring.",
  "keywords": [
    "herdr",
    "pi",
    "pi-package",
    "subagents"
  ],
  "homepage": "https://github.com/funsaized/pinata#readme",
  "bugs": {
    "url": "https://github.com/funsaized/pinata/issues"
  },
  "license": "MIT",
  "author": {
    "name": "funsaized",
    "url": "https://www.npmjs.com/~funsaized"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funsaized/pinata.git"
  },
  "bin": {
    "pinata": "bin/pinata.mjs"
  },
  "files": [
    "bin/",
    "engine/",
    "agents/",
    "skills/",
    "prompts/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:engine": "node --test \"test/engine/**/*.test.ts\"",
    "test:live": "node test/engine/live-smoke.ts",
    "eval:live": "node test/quality/engine.ts",
    "bench": "node --expose-gc bench/run.ts",
    "bench:loopback": "node --expose-gc bench/run.ts --provider loopback",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "lint": "oxlint test scripts engine bench bin examples/arena",
    "typecheck": "tsc -p tsconfig.json",
    "format:check": "oxfmt --check package.json tsconfig.json test scripts .github examples README.md docs skills prompts engine bench bin agents",
    "format": "oxfmt package.json tsconfig.json test scripts .github examples README.md docs skills prompts engine bench bin agents",
    "test:herdr": "node --test test/engine/herdr.test.ts",
    "arena:setup": "node examples/arena/cli.ts setup --pull",
    "arena:demo": "node examples/arena/cli.ts demo",
    "test:arena": "node --test test/arena/*.test.ts",
    "test:arena:browser": "node scripts/arena-browser-smoke.mjs",
    "arena:adapters:build": "node examples/arena/adapters/build.mjs",
    "arena:mock": "node examples/arena/adapters/mock-run.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "22.19.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "undici": "8.10.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./engine/pi/extension.ts"
    ],
    "skills": [
      "./skills/subagents"
    ],
    "prompts": [
      "./prompts/scout.md",
      "./prompts/builder.md",
      "./prompts/reviewer.md",
      "./prompts/pinata-review.md",
      "./prompts/pinata-fix.md"
    ],
    "themes": []
  }
}
