{
  "name": "pi-pinata",
  "version": "0.0.2",
  "description": "An extensible subagent runtime for Pi with durable assignments, shared workspaces, and live conversation controls.",
  "keywords": [
    "herdr",
    "pi",
    "pi-package",
    "subagents"
  ],
  "homepage": "https://github.com/funsaized/pinata#readme",
  "bugs": {
    "url": "https://github.com/funsaized/pinata/issues"
  },
  "license": "MIT",
  "author": {
    "name": "funsaized",
    "url": "https://www.npmjs.com/~funsaized"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funsaized/pinata.git"
  },
  "bin": {
    "pinata": "bin/pinata.mjs"
  },
  "files": [
    "bin/",
    "engine/",
    "agents/",
    "skills/",
    "prompts/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./engine/index.ts",
      "default": "./engine/public.mjs"
    },
    "./contracts": {
      "types": "./engine/contracts/public.ts",
      "default": "./engine/contracts/public.mjs"
    },
    "./runtime": {
      "types": "./engine/runtime/index.ts",
      "default": "./engine/runtime/public.mjs"
    },
    "./host": {
      "types": "./engine/host/index.ts",
      "default": "./engine/host/public.mjs"
    },
    "./sources": {
      "types": "./engine/sources/runtime.ts",
      "default": "./engine/sources/public.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:engine": "node --test \"test/engine/**/*.test.ts\"",
    "arena": "node arena/run.ts",
    "bench": "node --expose-gc bench/run.ts",
    "bench:loopback": "node --expose-gc bench/run.ts --provider loopback",
    "bench:process": "node --expose-gc bench/process.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "lint": "oxlint test scripts engine bench arena bin examples/relay/setup.mjs examples/relay/verify.mjs --ignore-pattern=arena/local/**",
    "typecheck": "tsc -p tsconfig.json",
    "format:check": "oxfmt --check package.json tsconfig.json test scripts .github examples README.md AGENTS.md STYLE.md docs skills prompts engine bench arena bin agents",
    "format": "oxfmt package.json tsconfig.json test scripts .github examples README.md AGENTS.md STYLE.md docs skills prompts engine bench arena bin agents",
    "test:herdr": "node --test test/engine/rewrite-process-backend.test.ts",
    "arena:bootstrap": "node arena/bootstrap.ts",
    "arena:local": "node arena/local-run.ts",
    "arena:doctor": "node arena/doctor.ts",
    "docs:setup": "node scripts/vale.mjs setup",
    "docs:lint": "node scripts/vale.mjs",
    "docs:lint:changed": "node scripts/vale.mjs --changed",
    "docs:lint:agents": "node scripts/vale.mjs --agents"
  },
  "dependencies": {
    "cron-parser": "5.10.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "22.19.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./engine/pi/extension.ts"
    ],
    "skills": [
      "./skills/subagents"
    ],
    "prompts": [
      "./prompts/scout.md",
      "./prompts/builder.md",
      "./prompts/reviewer.md",
      "./prompts/pinata-review.md",
      "./prompts/pinata-fix.md"
    ],
    "themes": []
  }
}
