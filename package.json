{
  "name": "pi-pinata",
  "version": "0.7.0",
  "description": "Fast, low-footprint Pi subagents: in-process agents, live-checkout readers, reviewed builder changes, and Herdr or external viewers when you want them.",
  "keywords": [
    "herdr",
    "pi",
    "pi-package",
    "subagents"
  ],
  "homepage": "https://github.com/funsaized/pinata#readme",
  "bugs": {
    "url": "https://github.com/funsaized/pinata/issues"
  },
  "license": "MIT",
  "author": {
    "name": "funsaized",
    "url": "https://www.npmjs.com/~funsaized"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funsaized/pinata.git"
  },
  "files": [
    "engine/",
    "skills/",
    "prompts/",
    "lib/",
    "docs/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "type": "module",
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:legacy": "node --test test/*.test.mjs",
    "test:engine": "node --test \"test/engine/**/*.test.ts\"",
    "test:pi": "node test/pi-smoke.mjs && node test/completion-smoke.mjs && node test/codemode-smoke.mjs",
    "test:herdr": "node test/herdr-smoke.mjs",
    "test:live": "node test/live-smoke.mjs",
    "test:e2e": "node test/e2e-build.mjs && node test/e2e-review.mjs",
    "eval:live": "node test/quality/live.mjs",
    "bench": "node bench/run.ts",
    "bench:loopback": "node bench/run.ts --provider loopback --compare",
    "bench:live": "node bench/run.ts --provider live",
    "bench:workspace": "node test/benchmark-workspace.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "lint": "oxlint lib test scripts engine bench",
    "typecheck": "tsc -p tsconfig.json",
    "format:check": "oxfmt --check package.json tsconfig.json lib test scripts .github examples README.md BACKLOG.md ENGINE_PLAN.md docs skills prompts engine bench",
    "format": "oxfmt package.json tsconfig.json lib test scripts .github examples README.md BACKLOG.md ENGINE_PLAN.md docs skills prompts engine bench"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "22.19.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./engine/pi/extension.ts"
    ],
    "skills": [
      "./skills/subagents",
      "./skills/engmgmt"
    ],
    "prompts": [
      "./prompts/scout.md",
      "./prompts/research.md",
      "./prompts/planner.md",
      "./prompts/builder.md",
      "./prompts/reviewer.md",
      "./prompts/pinata-review.md",
      "./prompts/pinata-fix.md"
    ],
    "themes": []
  }
}
