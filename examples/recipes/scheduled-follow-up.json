{
  "requestId": "example/schedule/create",
  "command": {
    "kind": "schedule",
    "schedule": {
      "action": "create",
      "id": "inspect",
      "target": {
        "template": {
          "id": "scheduled-scout",
          "agent": "scout",
          "task": "Inspect the current project changes and summarize new risks with file references. Do not edit files."
        }
      },
      "trigger": { "kind": "interval", "milliseconds": 300000 },
      "overlap": "skip"
    }
  }
}
